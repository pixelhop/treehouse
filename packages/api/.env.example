# API environment (packages/api). Copy to .env and fill in.

# Database (shared with packages/db)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54328/postgres"

# better-auth
# Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Signs public-share password-unlock cookies. REQUIRED in production (the API
# refuses to boot in production without it). Generate with: openssl rand -hex 32
SHARE_COOKIE_SECRET=""
# Public URL of THIS api (used as the auth base URL)
BETTER_AUTH_URL="http://localhost:3010"
# Public URL(s) of the front-end app (CORS + trusted origin for cookies).
# Comma-separated to allow several origins (prod app + Cloudflare preview URLs).
APP_URL="http://localhost:3000"

# Production only: when the app + API are subdomains of one custom domain
# (app./api.example.com), set this to the shared parent so the session cookie is
# shared across them. Leave blank in local dev.
COOKIE_DOMAIN=""
# Staging only: a different auth cookie name (e.g. "treehouse-staging"), so the
# production session cookie that also reaches staging's subdomain is ignored.
# Leave blank everywhere else.
AUTH_COOKIE_PREFIX=""

# Email (transactional: password resets, email verification, share-limit notices). Sent via
# Postmark when POSTMARK_SERVER_TOKEN is set; otherwise emails are logged to the
# server console (fine for local dev). EMAIL_FROM must be a verified Postmark
# sender signature and is REQUIRED once the token is set.
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM=""
# Postmark message stream to send on (defaults to "outbound").
POSTMARK_MESSAGE_STREAM=""
# New accounts must confirm their email before they can sign in whenever
# POSTMARK_SERVER_TOKEN is set. "true" or "false" overrides that; with "true" and
# no token, the verification link is printed to this console.
REQUIRE_EMAIL_VERIFICATION=""

# Workspace starter kit. Every newly created workspace is seeded with a README
# (its front page) and an AGENTS.md (a setup guide the user's own agent follows
# to interview them and build a folder structure). Set to 0 to create empty
# workspaces instead — e.g. a self-hosted instance that doesn't want opinionated
# starter content.
TREEHOUSE_SEED="1"

# Workers / queue (only needed if the api talks to Redis)
NITRO_REDIS_URL="redis://localhost:6380?family=0"

# Blob storage (file bytes). Leave the R2_* vars blank for local dev — the
# storage adapter falls back to the local filesystem driver (BLOB_DIR).
# In deployed environments, set all four R2_* vars to use Cloudflare R2 (S3 API).
#
# Production boot guard: when NODE_ENV=production and the R2_* vars are NOT set,
# the API refuses to boot unless BLOB_DIR is set EXPLICITLY (a deliberate
# filesystem opt-in pointing at a persistent volume). This prevents silently
# writing file bytes to ephemeral disk, where a redeploy would lose them. So a
# production instance must configure EITHER the R2_* vars OR a persistent
# BLOB_DIR. In local dev (no NODE_ENV=production) the default below is used.
BLOB_DIR=".data/blobs"
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Encryption at rest for file bytes. The master key (KEK) that wraps every
# workspace's data key. Format is `<id>:<base64>` where the decoded key is
# exactly 32 bytes. Generate one with:
#
#   printf 'v1:%s\n' "$(openssl rand -base64 32)"
#
# REQUIRED in production: the API refuses to boot without it, so file bytes are
# never silently written to storage unencrypted. Leave it blank in local dev and
# the blob store keeps writing plaintext, exactly as it did before this feature.
#
# ⚠️  LOSING THIS KEY LOSES EVERY FILE, PERMANENTLY. There is no recovery path —
# the bytes in the bucket are unreadable without it. Keep a backup somewhere that
# is not in the same blast radius as the deployment that holds it.
BLOB_KEK=""

# Comma-separated `<id>:<base64>` keys that are no longer used for new writes but
# must still open existing workspaces. Rotating the KEK takes two rollouts, so no
# pod ever meets a row sealed under a key it lacks: first add the new key (new id)
# here and let every pod restart; then swap, with the new key in BLOB_KEK and the
# old one here. The API re-seals every workspace's data key under the active KEK
# by itself (seconds; no blob is touched). Remove the old entry only after every
# pod runs with the new key active AND a later maintenance run (every 10 minutes)
# leaves GET /api/internal/keys/status showing no row under the old key.
BLOB_KEK_RETIRED=""

# Rotate every workspace's DATA key: an ISO-8601 instant with a time zone, e.g.
# "2026-10-30T09:00:00Z" (now, never in the future). Every workspace whose data
# key was created before it gets a new one, every stored object is re-encrypted
# under it, and each old key is destroyed a day later once nothing needs it.
# A day after the cutoff it also DELETES the stored bytes of deleted workspaces,
# which have no key left to re-encrypt them with.
# The response to "the database and the KEK may both have leaked". Remove it once
# the status endpoint shows nothing pending. Database backups taken before the
# rotation can no longer open files after it.
# See docs/solutions/security/rotating-blob-encryption-keys.md.
BLOB_DEK_ROTATE_BEFORE=""

# Byte Worker (optional). When BOTH are set, the file, version and share-link
# byte routes authorise as usual and then answer 307 to this Cloudflare Worker
# (packages/blob-worker) with an encrypted grant, so file bytes leave from
# Cloudflare instead of this server. Only browsers loading media/downloads and
# API clients sending `x-treehouse-byte-redirect: 1` are redirected, and only
# for encrypted blobs in R2. BLOB_WORKER_URL is the switch: set the key first,
# then the URL to turn it on; remove only the URL to turn it off. Any incomplete
# or invalid combination serves every byte from here (logged once), never errors.
# The token key must be identical on the Worker. Generate one with:
#   printf "t1:$(openssl rand -base64 32)"
# See docs/solutions/developer-experience/blob-worker-byte-path.md.
BLOB_WORKER_URL=""
BLOB_WORKER_TOKEN_KEY=""
# Retired grant keys still accepted for usage reports during rotation.
BLOB_WORKER_TOKEN_KEY_RETIRED=""

# Per-workspace storage limit (bytes). Leave blank/unset for unlimited — the
# limit mechanism is built but dormant until a positive value is set, and a
# non-numeric or non-positive value is treated as unlimited (fail open).
DEFAULT_WORKSPACE_QUOTA_BYTES=""

# Maximum size (bytes) of a single file upload. A PUT above this is rejected with
# 413 before the body is fully buffered (both on the declared Content-Length and
# mid-stream), and the MCP write tools refuse an over-cap write. Defaults to
# 104857600 (100 MB) — well below the ~2.1 GB FileNode.size ceiling; a
# non-numeric or non-positive value falls back to that default, and a value above
# that ceiling is clamped to it. Keep it low on a small instance: the write path
# buffers the whole body in memory.
MAX_FILE_BYTES=""

# Maximum bytes an MCP `read_file` call returns in one response, so a single tool
# call can't dump a huge file into the model's context. A file above this is
# refused unless the call passes an explicit `maxBytes` window (paged with
# `offset`). Defaults to 1048576 (1 MB); a non-numeric or non-positive value
# falls back to that default.
MCP_MAX_READ_BYTES=""

# ---------------------------------------------------------------------------
# PostHog (server-side error tracking + server-authoritative events). OPTIONAL.
#
# Leave POSTHOG_KEY blank and this is entirely inert — no client is constructed
# and nothing is sent. The API boots and serves normally either way.
#
# What it reports: 5xx exceptions from route handlers (with the request path
# RUN THROUGH REDACTION, because this API embeds user file paths in its own
# routes), and `file_changed` from the file service — the only honest view of
# agent traffic, since an agent writing through MCP is invisible to any browser.
# Never the request body, the query string, or auth headers.
# ---------------------------------------------------------------------------
POSTHOG_KEY=""
# EU Cloud ingestion host. The API talks to PostHog directly (it is not a
# browser, so there is no tracker blocker to work around and no proxy needed).
POSTHOG_HOST="https://eu.i.posthog.com"

# --- Billing (optional; limits are dormant without it) ---------------------
# Turn plan-limit enforcement on for this deployment. An org with a plan
# assigned to it (organization.metadata.plan) is enforced regardless.
# BILLING_ENABLED=1
# Force every org onto one tier — for local testing without a Stripe account.
# One of: seedling | grove | forest | legacy | unlimited
# DEFAULT_PLAN_SLUG=seedling

# Stripe (test mode locally). The webhook is served by the existing better-auth
# catch-all at /api/auth/stripe/webhook — no extra route is needed.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids for the two paid tiers, monthly and annual.
# STRIPE_PRICE_GROVE_MONTHLY=price_...
# STRIPE_PRICE_GROVE_ANNUAL=price_...
# STRIPE_PRICE_FOREST_MONTHLY=price_...
# STRIPE_PRICE_FOREST_ANNUAL=price_...

# Salt for the public-share visitor pseudonym. Falls back to BETTER_AUTH_SECRET
# when unset; set it explicitly to rotate view deduplication independently.
# SHARE_VIEW_SALT=

# Shared secret for service-to-service job calls (the BullMQ worker asks the API
# to reconcile subscriptions, because Stripe lives in this package and the
# worker deliberately depends only on `db`).
# INTERNAL_JOB_SECRET=

# How many FREE workspaces one user may own. Paid ones are uncapped — each pays
# for itself. Defaults to 1.
# FREE_WORKSPACES_PER_USER=1
