{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter db run prisma:generate && pnpm --filter api run build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter db run prisma:migrate:deploy",
    "startCommand": "node packages/api/.output/server/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}