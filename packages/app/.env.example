# App environment (packages/app). Copy to .env and adjust.
# Public URL of the API where better-auth is mounted.
# In production (Cloudflare), set this in the dashboard / wrangler vars.
NUXT_PUBLIC_API_URL=http://localhost:3010

# ---------------------------------------------------------------------------
# PostHog (analytics, session replay, error tracking, surveys). ALL OPTIONAL.
#
# Leave the key blank and analytics is fully off: the client plugin returns a
# no-op stub, the browser makes ZERO requests and stores nothing. That is the
# right setting for local dev, CI, and self-hosted instances — nobody should
# need a PostHog account to run Treehouse, and dev traffic must not pollute the
# production project.
# ---------------------------------------------------------------------------

# Project public key (safe to ship to browsers), e.g. phc_xxx. EU Cloud.
NUXT_PUBLIC_POSTHOG_KEY=""

# Where the browser sends events. Defaults to "/ph" — this app's OWN reverse
# proxy (server/routes/ph/[...path].ts), which exists so tracker blockers can't
# silently delete our data by matching on *.posthog.com. Only change this if you
# are self-hosting PostHog somewhere else.
NUXT_PUBLIC_POSTHOG_HOST="/ph"

# BUILD TIME ONLY — source map upload, so exceptions resolve to real .vue files
# instead of chunk-a1b2c3.js:1:48210. Both must be set or the upload is skipped;
# it NEVER fails the build, so contributors and CI without credentials are fine.
# The token is a PERSONAL API key (phx_xxx) and is a secret — never commit it.
POSTHOG_CLI_TOKEN=""
POSTHOG_PROJECT_ID=""

# ---------------------------------------------------------------------------
# "What's new" release notes from Hopdate (hopdate.pixelhop.io → the Treehouse
# project → Install). The project key is public. Leave it blank to hide the
# sidebar's "What's new" row, which is the default for local dev and self-hosting.
# ---------------------------------------------------------------------------
NUXT_PUBLIC_HOPDATE_PROJECT_KEY=""
# NUXT_PUBLIC_HOPDATE_API_URL="https://api.hopdate.pixelhop.io"

# ---------------------------------------------------------------------------
# Workspace tabs. "on" (the default) turns them on, with a toggle in the account
# menu to turn them off; "opt-in" starts them off with the toggle offered; "off"
# hides them. Anyone can still opt in by setting localStorage `th:tabs` to "1".
# ---------------------------------------------------------------------------
# NUXT_PUBLIC_TABS="on"
