# Treehouse sync CLI config (packages/cli).
# Either set these env vars, or create <sync-dir>/.treehouse/config.json with
# { "apiBase": "...", "apiKey": "...", "workspaceId": "..." }.

# Base URL of the Treehouse API (no trailing slash).
TREEHOUSE_API_BASE="http://localhost:3010"
# A workspace-scoped API key minted in the web app (Workspace → API keys).
TREEHOUSE_API_KEY=""
# The workspace id the key is scoped to.
TREEHOUSE_WORKSPACE_ID=""
