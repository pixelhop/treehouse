# Treehouse desktop app config (packages/desktop). These are BUILD-TIME values —
# the shell reads them at bundle time (esbuild) or app launch, not from a user's
# environment. Copy to .env only for a custom dev/self-host build.

# The default hosted app origin the shell trusts without a TOFU prompt. Any other
# origin (a self-hosted instance from an invite/deep link) must clear the
# trust-on-first-use confirmation before the shell loads it.
TREEHOUSE_APP_ORIGIN="https://app.trytree.house"

# The Apple Developer Team ID the bundled sync daemon must be signed with before the
# shell installs it at the always-running path (EXPECTED_TEAM_ID). BAKED at build
# time via scripts/build.mjs's esbuild `define` (release-desktop.yml sets it from
# APPLE_TEAM_ID). Leave empty for an unsigned local build — the app then fail-closes
# every daemon swap (the placeholder UNSET_TEAM_ID never matches a real signature).
TREEHOUSE_TEAM_ID=""
