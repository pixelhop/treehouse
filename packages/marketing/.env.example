# Marketing site environment (packages/marketing). Copy to .env and adjust.

# Where the CTAs send people. Override to point at a local or preview app.
NUXT_PUBLIC_APP_URL="https://app.trytree.house"

# ---------------------------------------------------------------------------
# PostHog. OPTIONAL — leave the key blank and nothing is loaded at all.
#
# Note the consent model differs from the product app: visitors here are
# anonymous and have agreed to nothing, so PostHog is NOT initialised until
# they accept the cookie banner (app/components/CookieBanner.vue). With no key
# configured the banner does not render either — showing a cookie banner for
# analytics that aren't running would be a lie.
# ---------------------------------------------------------------------------

# Project public key (phc_xxx). EU Cloud.
NUXT_PUBLIC_POSTHOG_KEY=""

# Defaults to this site's own reverse proxy at /ph (server/routes/ph/[...path].ts).
NUXT_PUBLIC_POSTHOG_HOST="/ph"

# ---------------------------------------------------------------------------
# Plausible page counts. OPTIONAL — leave blank and nothing is loaded. Not
# behind the cookie banner: Plausible sets no cookies. The script and events go
# through this site's own /pv proxy (server/routes/pv/). Set only in production;
# the id belongs to the trytree.house site, so anything else would be counted
# as production traffic.
# ---------------------------------------------------------------------------
NUXT_PUBLIC_PLAUSIBLE_SCRIPT_ID=""

# ---------------------------------------------------------------------------
# Chat Thing support bot. OPTIONAL — unset uses the production "Ask Treehouse"
# bot; set it to "" to hide the button, or to another id to try a different
# bot. Nothing from Chat Thing loads until a visitor clicks the button either
# way. Bot setup: chat-thing/support-bot.md.
# ---------------------------------------------------------------------------
# NUXT_PUBLIC_CHAT_THING_BOT_ID=""
