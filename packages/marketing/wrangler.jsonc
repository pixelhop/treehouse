{
  // Cloudflare Workers config for the Treehouse marketing site.
  // Build first (`pnpm build`), then `pnpm run deploy` (= `wrangler deploy`).
  // CI deploys it from .github/workflows/cloudflare.yml on merges to main.
  "name": "treehouse-marketing",
  // Each PR uploads a preview version at pr-<n>-treehouse-marketing.<subdomain>
  // .workers.dev (see the workflow). Off by default in wrangler; previews take
  // no production traffic.
  "preview_urls": true,
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // The docs are prerendered as <route>/index.html. Serve them at the clean
    // URL (/docs/files, not /docs/files/), which is the canonical form every
    // docs link, twin and llms.txt entry uses.
    "html_handling": "drop-trailing-slash",
    // Docs, comparison and guide requests reach the Worker first so
    // server/middleware/docs-assets.ts can answer `Accept: text/markdown` with
    // the page's .md twin. It still serves every file from these static assets.
    "run_worker_first": ["/docs", "/docs/*", "/compare", "/compare/*", "/guides/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Production hostnames — the marketing site owns the apex; www is attached so
  // it resolves rather than dead-ending (Cloudflare serves the same Worker).
  "routes": [
    { "pattern": "trytree.house", "custom_domain": true },
    { "pattern": "www.trytree.house", "custom_domain": true },
  ],
}