{
  // Standalone config: these helpers are consumed as raw TypeScript by the API,
  // the CLI, the desktop shell and both Nuxt apps, so they must type-check on
  // their own without any one consumer's framework types.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}