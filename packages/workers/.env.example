# Workers environment (packages/workers). Copy to .env and adjust.
NITRO_REDIS_URL="redis://localhost:6380?family=0"

# Bull Board (queue dashboard) basic-auth credentials. Local-only values: the
# dashboard is disabled when either is unset, so choose real ones when deploying.
NITRO_BULL_BOARD_USERNAME="admin"
NITRO_BULL_BOARD_PASSWORD="admin"

# Database (shared with packages/db), only if a job needs Prisma
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54328/postgres"

# Billing reconciliation calls back into the API (private network on Railway).
# INTERNAL_API_URL=http://api.railway.internal:3010
# INTERNAL_JOB_SECRET=
